GROQ_API_KEY=your_groq_api_key_here
GROQ_FALLBACK_API_KEY=your_fallback_api_key_here
GEMINI_API_KEY=your_gemini_api_key_here

# --- VECTOR DB (Chroma Cloud) ---
# From the "Connect" panel in your Chroma Cloud dashboard (https://www.trychroma.com).
CHROMA_HOST=api.trychroma.com
CHROMA_API_KEY=ck-your_chroma_api_key_here
CHROMA_TENANT=your_chroma_tenant_id_here
CHROMA_DATABASE=your_chroma_database_here

JINA_API_KEY=your_jina_api_key_here

# --- LLM GATEWAY (Portkey) ---
# Only PORTKEY_API_KEY is required. Routing works two ways:
#   1) PORTKEY_PRIMARY_CONFIG_ID set  → requests reference a saved Portkey
#      config (retry/fallback/cache configured in the Portkey UI), OR
#   2) empty config ID                → requests route via @<SLUG>/<MODEL>.
PORTKEY_API_KEY=your_portkey_api_key_here
PORTKEY_PRIMARY_CONFIG_ID=pc-your_config_id_here
PORTKEY_PRIMARY_SLUG=openrouter
PORTKEY_PRIMARY_MODEL=qwen/qwen3.8-27b:free

# Per-role model pool (full @slug/model strings). A failing model goes on
# cool-down and the gateway rotates to the next one in the pool.
# PORTKEY_MODEL_GUARDRAIL=@openrouter/qwen/qwen3.8-27b:free
# PORTKEY_MODEL_PLANNER=@gemini/gemini-3.6-flash
# PORTKEY_MODEL_RESPONDER=@policy/openai/gpt-oss-20b

# --- EVAL JUDGE (RAGAS Phase 2) ---
# Which LLM scores the eval. Decouples evals from the app's own Groq budget so
# one phase can't starve another:
#   portkey (default) → prod gateway, shares the app's battery/model TPD. Set
#                    EVAL_JUDGE_MODEL to "@<slug>/<model>" (e.g. @policy3/openai/gpt-oss-20b)
#                    to route the judge through a different Portkey provider
#                    config (its own quota pool) instead of the primary one.
#   groq              → direct api.groq.com via GROQ_FALLBACK_API_KEY
#   gemini            → OpenAI-compatible endpoint, separate free quota (recommended)
# EVAL_JUDGE_PROVIDER=portkey
# EVAL_JUDGE_MODEL=@policy3/openai/gpt-oss-20b   # or gemini-3.6-flash / openai/gpt-oss-20b

# --- GUARDRAILS LLM ---
# No paid key needed: OPENAI_API_KEY set → gpt-5-mini (paid); else GROQ_API_KEY
# → openai/gpt-oss-20b on Groq. Skipped with a warning if neither is set.
# GUARDRAIL_MODEL=           # optional override for the gate LLM
# GUARDRAILS_FAIL_OPEN=true  # true → provider error at query time logs and
#                            # proceeds to RAG; false → fail-closed (503).
OPENAI_API_KEY=your_openai_api_key_here

# --- SAFETY / CONTROL ---
# MASK_PII_IN_OUTPUT=false   # true → masks emails/phones/secret tokens in answers
# FACT_CHECK_ENABLED=true    # true → LLM grounds the answer vs retrieved evidence

# --- LLM GATEWAY HARDENING ---
# In-code fallback chain: Portkey @slug/model → Portkey defaults → direct Groq.
# GATEWAY_CACHE_ENABLED=true # Redis prompt/response cache (requires Redis). Caveat:
# GATEWAY_CACHE_TTL=1800     # exact-query responses are shared per model for TTL seconds.

# --- EVALS ---
# Defaults to ./evals/golden_dataset.json if unset.
# EVAL_DATASET=evals/golden_dataset.json

# --- API AUTH / PRODUCTION ---
# API_KEY=                     # When set, /query requires a valid bearer token
# STRICT_STARTUP=false
# RATE_LIMIT_PER_MINUTE=20
# RATE_LIMIT_ENABLED=true      # false disables the per-IP slowapi limiter (local/dev/eval runs)
# REDIS_URL=redis://localhost:6379/0
# LangGraph checkpointer Postgres. Local: postgresql://postgres:postgres@localhost:5432/langgraph
# Neon: use the UNPOOLED URL (DATABASE_URL_UNPOOLED) — CREATE INDEX CONCURRENTLY
# migrations fail over the -pooler endpoint.
# POSTGRES_URI=postgresql://<user>:<password>@<host>.aws.neon.tech/neondb?sslmode=require

# Optional. The SDK derives the correct endpoint (logfire-us/logfire-eu) from the token prefix.
# LOGFIRE_BASE_URL=

# --- DEPLOY / WIDGET / ADMIN (Render) ---
# CORS allow-list (comma separated) for the embed widget + admin cross-origin calls.
# ALLOWED_ORIGINS=https://kartikworks.co.in,https://www.kartikworks.co.in
# APP_BASE_URL=https://api.kartikworks.co.in
# Secret shared with the site admin page for /admin-api calls. Long random string.
# ADMIN_TOKEN=change_me_long_random_string
# ADMIN_LOGGING_ENABLED=true   # false → skip chat_logs writes (saves Neon IO)
# PORT=8000                    # Render injects the real one
# DATA_DIR=data                # folder the daily re-ingestion reads
# DAILY_INGEST_HOUR=5          # UTC hour for the daily tick
# DATA_SOURCE_TYPE=true        # source tag when data/ has no sub-folders

# --- WEB / STRUCTURED INGESTION (the "about me" live data) ---
# Supabase PostgREST source: rows are pulled per table, rendered to text, and
# indexed through the exact same chunk/embed/Chroma path as local files.
# SUPABASE_URL=https://xxxx.supabase.co
# SUPABASE_ANON_KEY=your_anon_key_here
# SUPABASE_TABLES=projects,experience_entries,portfolio_tools,resume
# Optional extra sources: live server-rendered pages or plain-JSON endpoints.
#   type=page  → fetched HTML run through the shared BeautifulSoup parser
#   type=json  → body parsed as a JSON array of records
# WEB_SOURCES_JSON=[{"url":"https://github.com/you","type":"page","title":"github_profile","source_type":"web"}]