GROQ_API_KEY=your_groq_api_key_here
GROQ_FALLBACK_API_KEY=your_fallback_api_key_here
GEMINI_API_KEY=your_gemini_api_key_here

# --- VECTOR DB (Chroma Cloud) ---
# From the "Connect" panel in your Chroma Cloud dashboard (https://www.trychroma.com).
CHROMA_HOST=api.trychroma.com
CHROMA_API_KEY=ck-your_chroma_api_key_here
CHROMA_TENANT=your_chroma_tenant_id_here
CHROMA_DATABASE=your_chroma_database_here

JINA_API_KEY=your_jina_api_key_here

# --- LLM GATEWAY (Portkey) ---
# Only PORTKEY_API_KEY is required. Routing works two ways:
#   1) PORTKEY_PRIMARY_CONFIG_ID set  → requests reference a saved Portkey
#      config (retry/fallback/cache configured in the Portkey UI), OR
#   2) empty config ID                → requests route via @<SLUG>/<MODEL>.
PORTKEY_API_KEY=your_portkey_api_key_here
PORTKEY_PRIMARY_CONFIG_ID=pc-your_config_id_here
PORTKEY_PRIMARY_SLUG=groq
PORTKEY_PRIMARY_MODEL=openai/gpt-oss-20b

# --- GUARDRAILS LLM ---
# No paid key needed: OPENAI_API_KEY set → gpt-5-mini (paid); else GROQ_API_KEY
# → openai/gpt-oss-20b on Groq. Skipped with a warning if neither is set.
# GUARDRAIL_MODEL=           # optional override for the gate LLM
# GUARDRAILS_FAIL_OPEN=true  # true → provider error at query time logs and
#                            # proceeds to RAG; false → fail-closed (503).
OPENAI_API_KEY=your_openai_api_key_here

# --- API AUTH / PRODUCTION ---
# API_KEY=                     # When set, /query requires a valid bearer token
# STRICT_STARTUP=false
# RATE_LIMIT_PER_MINUTE=20
# REDIS_URL=redis://localhost:6379/0
# LangGraph checkpointer Postgres. Local: postgresql://postgres:postgres@localhost:5432/langgraph
# Neon: use the UNPOOLED URL (DATABASE_URL_UNPOOLED) — CREATE INDEX CONCURRENTLY
# migrations fail over the -pooler endpoint.
# POSTGRES_URI=postgresql://<user>:<password>@<host>.aws.neon.tech/neondb?sslmode=require

# Optional. The SDK derives the correct endpoint (logfire-us/logfire-eu) from the token prefix.
# LOGFIRE_BASE_URL=